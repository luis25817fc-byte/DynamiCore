def generar_interfaz_base():
    """
    Genera el cascarón modular de React para Vite.
    Mapea el Menú Lateral, el Globo Vectorial y los bloques inferiores de analítica.
    """
    codigo_componente = """
    import React, { useState, useEffect, useRef } from 'react';

    // Componente: Menú Lateral Dinámico
    function Sidebar() {
      const [active, setActive] = useState('OVERVIEW');
      const items = ['OVERVIEW', 'ANÁLISIS', 'SISTEMAS', 'PREDICCIÓN', 'ALERTAS', 'AI ANALYST', 'CONFIGURACIÓN'];
      
      return (
        <aside className="w-64 glass-panel border-r border-cyan-950 p-6 flex flex-col gap-8 h-full">
          <div>
            <h1 className="text-xl font-black tracking-tighter text-white">DYNAMICORE</h1>
            <p className="text-[9px] text-cyan-400 tracking-widest font-mono mt-1">THE UNIFIED INTELLIGENCE ENGINE</p>
          </div>
          <nav className="flex flex-col gap-2">
            {items.map((item) => (
              <button
                key={item}
                onClick={() => setActive(item)}
                className={`w-full text-left px-4 py-3 rounded-lg text-xs font-bold tracking-widest transition-all duration-200 ${
                  active === item 
                    ? 'bg-cyan-950/50 text-yellow-400 border-l-2 border-yellow-400 font-black' 
                    : 'text-slate-400 hover:text-white hover:bg-slate-900/30'
                }`}
              >
                {item}
              </button>
            ))}
          </nav>
          <div className="mt-auto border-t border-cyan-950 pt-4 text-center">
            <span className="text-[10px] font-mono text-cyan-600">SISTEMA OPERATIVO ONLINE</span>
          </div>
        </aside>
      );
    }

    // Componente: Globo Central Estructural (Optimizado para Celular)
    function CentralGlobe() {
      const [rotating, setRotating] = useState(true);
      const [rotation, setRotation] = useState(0);
      const touchStart = useRef(0);
      const timer = useRef(null);

      useEffect(() => {
        if (!rotating) return;
        const interval = setInterval(() => {
          setRotation((prev) => (prev + 0.5) % 360);
        }, 16);
        return () => clearInterval(interval);
      }, [rotating]);

      return (
        <div 
          className="w-full h-64 flex items-center justify-center relative cursor-grab"
          onTouchStart={(e) => { setRotating(false); if (timer.current) clearTimeout(timer.current); touchStart.current = e.touches[0].clientX; }}
          onTouchMove={(e) => { const delta = e.touches[0].clientX - touchStart.current; setRotation((prev) => (prev + delta * 0.1) % 360); touchStart.current = e.touches[0].clientX; }}
          onTouchEnd={() => { timer.current = setTimeout(() => setRotating(true), 5000); }}
        >
          <svg width="220" height="220" viewBox="0 0 200 200" style={{ transform: `rotate(${rotation}deg)` }} className="transition-transform duration-75">
            <circle cx="100" cy="100" r="80" fill="none" stroke="#06b6d4" strokeWidth="1" strokeDasharray="4 4" className="opacity-40" />
            <circle cx="100" cy="100" r="60" fill="none" stroke="#ffd700" strokeWidth="0.5" strokeDasharray="2 8" />
            <circle cx="40" cy="100" r="4" fill="#ffd700" className="animate-pulse" />
            <circle cx="160" cy="100" r="4" fill="#06b6d4" />
            <circle cx="100" cy="40" r="5" fill="#ef4444" />
            <path d="M 40 100 Q 100 40 160 100" fill="none" stroke="#06b6d4" strokeWidth="1" className="opacity-30" />
          </svg>
          <div className="absolute bottom-2 text-center w-full">
            <p className="text-[9px] font-mono text-slate-500 uppercase tracking-widest">Panel Central Estructural 3D</p>
          </div>
        </div>
      );
    }

    // Componente Contenedor Base Estilo Render Aprobado
    function Card({ title, statusText, children, className = "" }) {
      return (
        <div className={`glass-panel rounded-xl p-4 flex flex-col gap-3 ${className}`}>
          {(title || statusText) && (
            <div className="flex justify-between items-center border-b border-cyan-950 pb-2">
              {title && <h2 className="text-xs font-bold tracking-widest text-cyan-400 uppercase">{title}</h2>}
              {statusText && <span className="text-[10px] text-yellow-500 font-mono tracking-wider">{statusText}</span>}
            </div>
          )}
          <div className="flex-1 overflow-hidden">{children}</div>
        </div>
      );
    }

    // Vista Principal Unificada
    export default function App() {
      return (
        <div className="flex h-screen w-screen bg-[#020617] text-white p-4 gap-4 overflow-hidden">
          <Sidebar />
          <main className="flex-1 flex flex-col gap-4 overflow-y-auto pr-1">
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <Card title="ESTADO DEL SISTEMA" statusText="ESTABILIDAD GLOBAL: 98.7%">
                <div className="flex flex-col gap-2 font-mono text-xs p-2">
                  <div className="flex justify-between"><span className="text-slate-500">Entropía</span><span className="text-cyan-400">21.9818</span></div>
                  <div className="flex justify-between"><span className="text-slate-500">Coherencia</span><span className="text-emerald-400">0.9237</span></div>
                  <div className="flex justify-between"><span className="text-slate-500">Nodos</span><span className="text-yellow-400">5,000,000</span></div>
                </div>
              </Card>
              <Card title="MAPA ESTRUCTURAL 3D">
                <CentralGlobe />
              </Card>
              <Card title="EXPLORACIÓN 3D - FLUJO DE ENTROPÍA" statusText="RIESGO: BAJO">
                <div className="h-full flex items-center justify-center border border-dashed border-cyan-950/60 rounded-lg bg-cyan-950/10 min-h-[200px]">
                  <span className="text-[10px] font-mono text-cyan-600 tracking-wider">Espacio reservado para Gráfica Cinética</span>
                </div>
              </Card>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 flex-1">
              <Card title="MÉTRICAS EN TIEMPO REAL">
                <div className="text-xs font-mono p-1 flex flex-col gap-3">
                  <div><p className="text-slate-500 text-[10px]">LATENCIA PROMEDIO</p><p className="text-lg text-yellow-400 font-bold">501.21 ms</p></div>
                  <div className="w-full bg-slate-950 h-1 rounded overflow-hidden"><div className="bg-yellow-400 h-full w-2/3"></div></div>
                </div>
              </Card>
              <Card title="PREDICCIÓN INTELIGENTE" statusText="CRÍTICO">
                <div className="flex flex-col justify-center items-center h-full gap-1 min-h-[120px]">
                  <h3 className="text-3xl font-black text-red-500 font-mono">87%</h3>
                  <p className="text-[9px] text-center font-mono text-slate-400 tracking-wide">PROBABILIDAD EN PRÓXIMAS 48H</p>
                </div>
              </Card>
              <Card title="ALERTAS INTELIGENTES">
                <div className="text-[10px] font-mono flex flex-col gap-2">
                  <div className="p-2 bg-red-950/30 border border-red-900/50 rounded text-red-400">🚨 Riesgo Crítico en Sector Alpha</div>
                </div>
              </Card>
              <Card title="AI ANALYST" statusText="ACTIVO">
                <div className="text-xs text-slate-300 italic p-2 flex flex-col gap-2">
                  <p className="text-cyan-400 font-bold not-italic text-[10px]">MÓDULO DE VOZ:</p>
                  "Se detectó un aumento en la entropía de la región noreste."
                </div>
              </Card>
            </div>
          </main>
        </div>
      );
    }
    """
    return codigo_componente

if __name__ == "__main__":
    print("[LOG] Estructura visual de la Fase 1 integrada correctamente al compilador.")
  
